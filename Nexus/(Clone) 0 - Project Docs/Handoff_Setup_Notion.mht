.automation-list-item-base-step:not(.automation-list-item-base-step--drag-disabled):hover .automation-list-item-icon { opacity: 0; }

.automation-list-item-base-step:not(.automation-list-item-base-step--drag-disabled):hover .automation-list-item-drag-handle { opacity: 1; }

.automation-list-item-drag-handle:active { cursor: grabbing; }

.app-builder-notification-activity--light a { color: rgba(55, 53, 47, 0.65); }

.app-builder-notification-activity--dark a { color: rgba(255, 255, 255, 0.443); }

@keyframes selectedOutlineScale { 
  0%, 100% { outline: rgb(255, 205, 56) solid 2px; }
  50% { outline-width: 5px; }
}

.in-page-find-selected-highlight-match { animation: 0.15s ease-in-out 0s 1 normal none running selectedOutlineScale; }

.temporary-dictation-annotation { opacity: 0.3; }

.marketplace-checkout-email-element { pointer-events: none; }

@keyframes slideInFromLeft { 
  0% { opacity: 0; transform: translate(-4px); }
  100% { opacity: 1; transform: translate(0px); }
}

@keyframes template-preview-column-focus-in { 
  0% { filter: blur(6px); opacity: 0; }
  100% { filter: blur(); opacity: 1; }
}

@keyframes template-preview-column-focus-out { 
  0% { filter: blur(0.01px); opacity: 1; }
  100% { filter: blur(6px); opacity: 0; min-width: 0px; }
}

.quickActionContainer:empty { visibility: hidden; }

.popup-origin-wrapper:has(svg) > * { transform: translateZ(0px); }

@property --shimmer-text-faded-color { syntax: "<color>"; inherits: false; initial-value: #0f0; }

@keyframes spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.citation-annotation-token { width: 12px !important; height: 12px !important; }

.inference-transcript-chat-step .citation-annotation-token { width: 14px !important; height: 14px !important; }

.inference-transcript-chat-step .citation-annotation-anchor { min-width: 22px; height: 22px; margin-bottom: -2px; margin-left: 2px; margin-right: 0px; font-size: 12px; }

.citation-annotation-anchor { min-width: 18px; height: 18px; margin-bottom: -2px; margin-left: 2px; margin-right: 1px; font-size: 10px; }

.inference-transcript-chat-step .citation-annotation-span { min-width: 20px; height: 20px; margin-bottom: -3px; margin-left: 2px; font-size: 12px; }

.citation-annotation-span { min-width: 16px; height: 16px; margin-left: 4px; font-size: 10px; }

.notion-dark-theme .logo-light-mode { display: none; }

.notion-dark-theme .logo-dark-mode { display: initial; }

.notion-light-theme .logo-dark-mode { display: none; }

.notion-light-theme .logo-light-mode { display: initial; }

html[dir="rtl"] .directional-icon { transform: scaleX(-1); }

.tr-with-border-radius > td:first-child { border-radius: 12px 0px 0px 12px; }

.tr-with-border-radius > td:last-child { border-radius: 0px 12px 12px 0px; }

::spelling-error { text-underline-offset: 2px; text-decoration-skip-ink: none; text-decoration-line: underline; text-decoration-style: dotted; text-decoration-color: var(--c-redTexAccPri); }

.content-editable-leaf-rtl { unicode-bidi: plaintext; }

.notion-selectable-rtl .content-editable-leaf-rtl, .notion-selectable-ltr .content-editable-leaf-rtl, .notion-table-cell .content-editable-leaf-rtl { unicode-bidi: inherit; }

.agent-title-input::placeholder { color: var(--cl-pagTitPlaTexCol); opacity: 1; }

@keyframes pulse-opacity { 
  0% { opacity: 0.3; }
  50% { opacity: 1; }
  100% { opacity: 0.3; }
}

.pulse-opacity { animation: 1.8s linear 0s infinite normal none running pulse-opacity; }

.video-hide-default-controls::-webkit-media-controls { display: none !important; }

.video-hide-default-controls::-webkit-media-controls-enclosure { display: none !important; }

.video-hide-default-controls::-webkit-media-controls-overlay-play-button { display: none !important; }

.video-progress-shimmer { z-index: 0; position: relative; overflow: hidden; }

.video-progress-shimmer::before { content: ""; z-index: 1; width: 100%; height: 100%; animation: 1s linear 0s infinite normal none running shimmer; position: absolute; }

.notion-light-theme .video-progress-shimmer::before { background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.4) 50%, rgba(255, 255, 255, 0) 100%); }

.notion-dark-theme .video-progress-shimmer::before { background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) 100%); }

.content-editable-void-no-select { user-select: none; }

.content-editable-void-no-select::selection { background: 0px 0px; }

.content-editable-void-no-select ::selection { background: 0px 0px; }

.slippery-slope-empty-state-layout:last-child, .slippery-slope-empty-state-layout:nth-child(2):nth-last-child(2) { flex-grow: 1; }

@media print {
  .notion-ai-button, .agent-file-preview { display: none !important; }
}

