def _normalize_scd_type(scd_type: Any, track_history: Any) -> int:
    if track_history is True and scd_type in (None, "", 1, "1"):
        scd_type = 2
    text = str(scd_type).strip().lower().replace(" ", "").replace("-", "").replace("_", "")
    text = text.replace("type", "").replace("scd", "")
    if text in {"1", "scd1"}:
        return 1
    if text in {"2", "scd2"}:
        return 2
    raise ValueError(
        f"Invalid scd_type {scd_type!r}. Use 1 / 2 / 'SCD1' / 'SCD2' / 'Type 1' / 'Type 2'."
    )


def _coerce_sequence_columns(value: Any) -> List[str]:
    if isinstance(value, str):
        return [_ident(value, "sequence_column")]
    if isinstance(value, Sequence):
        cols = _ident_list(value, "sequence_column")
        if not cols:
            raise ValueError("sequence_column must not be empty.")
        return cols
    raise ValueError("sequence_column must be a column name or a list of column names.")


def _default_except_columns(
    except_column_list: Any, operation_column: Optional[str]
) -> Optional[List[str]]:
    if except_column_list is not None:
        return _ident_list(except_column_list, "except_column_list")
    if operation_column:
        return [operation_column]
    return None


def _default_delete_sql(operation_column: str, delete_values: Sequence[str]) -> str:
    seen: set[str] = set()
    literals: list[str] = []
    for value in delete_values:
        token = value.upper().replace("'", "''")
        if token in seen:
            continue
        seen.add(token)
        literals.append(f"'{token}'")
    return f"upper(cast(`{operation_column}` AS STRING)) IN ({', '.join(literals)})"


def _split_object_name(name: str, *, field: str) -> tuple[Optional[str], Optional[str], str]:
    parts = [part.strip() for part in name.split(".") if part.strip()]
    if not parts or len(parts) > 3:
        raise ValueError(f"{field} must be table or catalog.schema.table, got {name!r}.")
    if len(parts) == 1:
        return None, None, parts[0]
    if len(parts) == 2:
        return None, parts[0], parts[1]
    return parts[0], parts[1], parts[2]


def _ident(name: str, field: str) -> str:
    cleaned = name.strip().strip("`")
    if not _IDENT_RE.fullmatch(cleaned):
        raise ValueError(f"{field} must be a simple SQL identifier, got {name!r}.")
    return cleaned


def _ident_list(value: Any, field: str) -> List[str]:
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, Iterable) or isinstance(value, (bytes, bytearray)):
        raise ValueError(f"{field} must be a list of identifiers.")
    return [_ident(str(item), field) for item in value]


def _optional_ident_list(value: Any, field: str) -> Optional[List[str]]:
    if value in (None, "", []):
        return None
    return _ident_list(value, field)


def _string_list(value: Any, field: str) -> List[str]:
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, Iterable) or isinstance(value, (bytes, bytearray)):
        raise ValueError(f"{field} must be a list of strings.")
    items = [str(item).strip() for item in value if str(item).strip()]
    if not items:
        raise ValueError(f"{field} must not be empty.")
    return items


def _optional_bool(value: Any) -> Optional[bool]:
    if value is None:
        return None
    return bool(value)


def _first_present(colset: Mapping[str, str], candidates: Sequence[str]) -> Optional[str]:
    for name in candidates:
        if name and name.lower() in colset:
            return colset[name.lower()]
    return None


def _safe_ident(name: str) -> str:
    ident = re.sub(r"[^0-9A-Za-z_]", "_", name)
    if not ident or ident[0].isdigit():
        ident = f"t_{ident}"
    return ident
