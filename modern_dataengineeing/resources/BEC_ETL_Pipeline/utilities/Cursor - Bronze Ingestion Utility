def _pipelines_api() -> Any:
    """Prefer ``pyspark.pipelines`` (Lakeflow); fall back to legacy ``dlt``."""
    try:
        from pyspark import pipelines as dp

        return dp
    except ImportError:
        pass
    try:
        import dlt

        return dlt
    except ImportError as exc:  # pragma: no cover
        raise ImportError(
            "Neither pyspark.pipelines nor dlt is available. "
            "Attach this file as a Databricks Lakeflow / DLT pipeline source."
        ) from exc


def _first_attr(api: Any, *names: str) -> Callable[..., Any]:
    for name in names:
        fn = getattr(api, name, None)
        if callable(fn):
            return fn
    raise AttributeError(
        f"Pipelines API {type(api).__name__} is missing any of: {', '.join(names)}"
    )


def _call_supported(fn: Callable[..., Any], **kwargs: Any) -> Any:
    """Invoke ``fn``, dropping None values and kwargs the runtime signature rejects."""
    cleaned = {key: value for key, value in kwargs.items() if value is not None}
    try:
        signature = inspect.signature(fn)
    except (TypeError, ValueError):
        return fn(**cleaned)
    if any(
        param.kind == inspect.Parameter.VAR_KEYWORD
        for param in signature.parameters.values()
    ):
        return fn(**cleaned)
    allowed = set(signature.parameters)
    return fn(**{key: value for key, value in cleaned.items() if key in allowed})


def _decorate(decorator_fn: Callable[..., Any], impl: Callable[..., Any], **kwargs: Any) -> Any:
    decorator = _call_supported(decorator_fn, **kwargs)
    return decorator(impl)


def _read_pipeline_dataset(api: Any, name: str) -> Any:
    reader = getattr(api, "read", None)
    if callable(reader):
        return reader(name)
    import dlt

    return dlt.read(name)


def _active_spark() -> Any:
    from pyspark.sql import SparkSession

    spark = SparkSession.getActiveSession()
    if spark is None:
        spark = SparkSession.builder.getOrCreate()
    return spark


def _sequence_by_expr(sequence_columns: Sequence[str]) -> Any:
    from pyspark.sql import functions as F

    if len(sequence_columns) == 1:
        return F.col(sequence_columns[0])
    return F.struct(*[F.col(col) for col in sequence_columns])


