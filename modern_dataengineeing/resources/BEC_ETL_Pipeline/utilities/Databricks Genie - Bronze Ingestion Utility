"""
bronze_dlt_factory.py
=====================

Metadata-driven factory module that generates Bronze-layer Delta Live
Tables (DLT) from raw CDC source tables in Unity Catalog.

Architecture
------------
Each Bronze table is produced in three DLT stages:

1. **Streaming Table** -- ``dlt.create_streaming_table()`` defines the
   physical target that holds CDC-applied data.

2. **Apply Changes** -- ``dlt.apply_changes()`` consumes the raw source
   incrementally, deduplicates by primary key, orders by the sequence
   column, and materialises the result as SCD Type 1 (current-state-only)
   or SCD Type 2 (full history).

3. **View Overlay** -- A ``dlt.view`` reads the physical target and
   projects DLT's native SCD2 tracking columns onto the
   enterprise-standard ``dl_*`` columns:

   +------------------+------------------+
   | Native DLT col   | Enterprise col   |
   +==================+==================+
   | __START_AT       | dl_starttimeutc  |
   | __END_AT         | dl_endtimeutc    |
   | __END_AT IS NULL | dl_iscurrent     |
   | op = 'DELETE'    | dl_isdeleted     |
   +------------------+------------------+

   For SCD Type 1 (``track_history=False``) the physical table contains
   only the latest version of each key, so ``__END_AT`` is always NULL and
   every visible row is current.  Hard-deleted rows are physically removed,
   hence ``dl_isdeleted`` is always FALSE for SCD1.

   For SCD Type 2 (``track_history=True``) the physical table retains every
   version.  ``except_apply`` is used so that delete events are stored as
   tombstone rows (``op = 'DELETE'``) rather than being discarded, allowing
   ``dl_isdeleted`` to surface soft-delete markers while ``dl_iscurrent``
   remains TRUE for the tombstone (it IS the latest version of that key).

Native-to-Enterprise Column Mapping
------------------------------------
Both SCD1 and SCD2 use ``stored_as_scd_type=2`` so that the physical
``__START_AT`` / ``__END_AT`` columns always exist.  The difference is
solely in ``track_history``:

* SCD1: ``stored_as_scd_type=2, track_history=False``  -> latest version only
* SCD2: ``stored_as_scd_type=2, track_history=True``   -> full history

This guarantees a uniform view-mapping function regardless of SCD type.
"""

from __future__ import annotations

import dlt
from pyspark.sql.functions import col, lit, when
from typing import Any, Dict, List, Optional

# --------------------------------------------------------------------
# Unity Catalog locations
# --------------------------------------------------------------------
RAW_SCHEMA: str = "mde_dev.bec_raw"
BRONZE_SCHEMA: str = "mde_dev.bronze"

# --------------------------------------------------------------------
# DLT native SCD2 tracking column names (generated by apply_changes)
# --------------------------------------------------------------------
_NATIVE_START_AT: str = "__START_AT"
_NATIVE_END_AT: str = "__END_AT"


def generate_bronze_table(config: Dict[str, Any]) -> None:
    """
    Dynamically generate a Bronze-layer DLT table from a raw source table.

    This function registers three DLT objects:

    1. A streaming table (the physical CDC target).
    2. An ``apply_changes`` flow that processes incremental CDC events.
    3. A view overlay that maps DLT's native SCD columns to ``dl_*`` columns.

    Parameters
    ----------
    config : dict
        Declarative configuration for a single Bronze table.

        Required keys
        ~~~~~~~~~~~~~
        - ``table_name``       (str)        Source & target table name.
        - ``primary_keys``     (List[str])  Primary-key column(s).
        - ``sequence_column`` (str)        Monotonic CDC ordering column.
        - ``operation_column`` (str)        Column marking delete events.
        - ``scd_type``         (int)        1 (upsert, no history) or 2
                                            (full history with tombstones).

        Optional keys
        ~~~~~~~~~~~~~
        - ``source_schema``    (str)  Override raw schema (default RAW_SCHEMA).
        - ``target_schema``    (str)  Override bronze schema (default BRONZE_SCHEMA).
        - ``delete_value``     (str)  Value in operation_column that signals a
                                      delete (default ``"DELETE"``).
        - ``table_properties`` (dict) Extra Delta table properties.
        - ``expectations``     (dict) ``{name: sql_expr}`` data-quality rules.
        - ``description``      (str)  Table comment / documentation.

    Raises
    ------
    ValueError
        If ``scd_type`` is not 1 or 2, or required keys are missing.

    Examples
    --------
    >>> generate_bronze_table({
    ...     "table_name": "customers",
    ...     "primary_keys": ["customer_id"],
    ...     "sequence_column": "updated_at",
    ...     "operation_column": "op",
    ...     "scd_type": 2,
    ... })
    """
    # -- validate config --------------------------------------------------
    required: List[str] = [
        "table_name",
        "primary_keys",
        "sequence_column",
        "operation_column",
        "scd_type",
    ]
    missing = [k for k in required if k not in config]
    if missing:
        raise ValueError(f"Missing required config keys: {missing}")

    table_name: str = config["table_name"]
    primary_keys: List[str] = config["primary_keys"]
    sequence_column: str = config["sequence_column"]
    operation_column: str = config["operation_column"]
    scd_type: int = config["scd_type"]

    if scd_type not in (1, 2):
        raise ValueError(f"scd_type must be 1 or 2, got {scd_type}")

    # -- optional config --------------------------------------------------
    source_schema: str = config.get("source_schema", RAW_SCHEMA)
    target_schema: str = config.get("target_schema", BRONZE_SCHEMA)
    delete_value: str = config.get("delete_value", "DELETE")
    table_props: Dict[str, str] = config.get("table_properties", {})
    expectations: Dict[str, str] = config.get("expectations", {})
    description: str = config.get(
        "description",
        f"Bronze layer CDC table for {table_name} (SCD Type {scd_type})",
    )

    # -- derived names ----------------------------------------------------
    source_table: str = f"{source_schema}.{table_name}"
    target_name: str = table_name              # DLT logical name (unqualified)
    target_qualified: str = f"{target_schema}.{target_name}"
    view_name: str = f"{target_name}_v"        # view overlay logical name

    delete_condition: str = f"{operation_column} = '{delete_value}'"

    # ===================================================================
    # 1. Streaming table (physical CDC target)
    # ===================================================================
    dlt.create_streaming_table(
        name=target_name,
        table_properties={
            "quality": "bronze",
            "delta.enableChangeDataFeed": "true",
            **table_props,
        },
        comment=description,
    )

    # data-quality expectations (optional)
    for exp_name, exp_sql in expectations.items():
        dlt.expect(name=exp_name, expr=exp_sql)

    # ===================================================================
    # 2. Apply changes (CDC engine)
    # ===================================================================
    if scd_type == 2:
        # ---- SCD Type 2: full history with tombstone retention ---------
        # apply_as_deletes  -> marks delete events, closes current version
        # except_apply      -> retains the delete event as a tombstone row
        #                      so that dl_isdeleted can be derived.
        dlt.apply_changes(
            target=target_name,
            source=source_table,
            keys=primary_keys,
            sequence_by=sequence_column,
            stored_as_scd_type=2,
            track_history=True,
            apply_as_deletes=delete_condition,
            except_apply=delete_condition,
        )
    else:
        # ---- SCD Type 1: current-state only; deletes are hard-deleted ---
        # stored_as_scd_type=2 gives us __START_AT / __END_AT columns,
        # but track_history=False keeps only the latest version per key.
        # except_apply is NOT supported for SCD1, so deletes remove rows.
        dlt.apply_changes(
            target=target_name,
            source=source_table,
            keys=primary_keys,
            sequence_by=sequence_column,
            stored_as_scd_type=2,
            track_history=False,
            apply_as_deletes=delete_condition,
        )

    # ===================================================================
    # 3. View overlay (native DLT columns -> dl_* enterprise columns)
    # ===================================================================
    _create_metadata_view(
        view_name=view_name,
        target_qualified=target_qualified,
        scd_type=scd_type,
        operation_column=operation_column,
        delete_value=delete_value,
    )


def _create_metadata_view(
    view_name: str,
    target_qualified: str,
    scd_type: int,
    operation_column: str,
    delete_value: str,
) -> None:
    """
    Register a ``dlt.view`` that projects the physical target's native
    DLT SCD columns onto the enterprise ``dl_*`` schema.

    The view is closed over its arguments so that each call to
    ``generate_bronze_table`` produces an independent view with the
    correct table reference -- even when the factory is called in a loop.
    """
    native_cols = {_NATIVE_START_AT, _NATIVE_END_AT}

    @dlt.view(name=view_name)
    def _bronze_overlay():
        """Project native SCD2 columns onto the dl_* enterprise schema."""
        df = spark.read.table(target_qualified)

        # All source data columns except native DLT tracking columns
        data_cols = [c for c in df.columns if c not in native_cols]
        select_exprs = [col(c) for c in data_cols]

        # -- dl_iscurrent -------------------------------------------------
        # A record is current when __END_AT is NULL (no newer version).
        select_exprs.append(
            (col(_NATIVE_END_AT).isNull()).alias("dl_iscurrent")
        )

        # -- dl_isdeleted -------------------------------------------------
        if scd_type == 2:
            # Tombstone rows retained via except_apply carry the delete
            # marker in the operation column.
            select_exprs.append(
                when(col(operation_column) == lit(delete_value), lit(True))
                .otherwise(lit(False))
                .alias("dl_isdeleted")
            )
        else:
            # SCD1 hard-deletes physically remove rows; every remaining
            # row is a live, non-deleted record.
            select_exprs.append(lit(False).alias("dl_isdeleted"))

        # -- dl_starttimeutc ---------------------------------------------
        # __START_AT is the DLT-generated timestamp/sequence marking when
        # this version became effective.
        select_exprs.append(
            col(_NATIVE_START_AT).cast("timestamp").alias("dl_starttimeutc")
        )

        # -- dl_endtimeutc -----------------------------------------------
        # __END_AT is NULL for the current version and non-NULL for
        # superseded historical versions.
        select_exprs.append(
            col(_NATIVE_END_AT).cast("timestamp").alias("dl_endtimeutc")
        )

        return df.select(*select_exprs)


# ---------------------------------------------------------------------
# ARCHITECTURE EXPLANATION: Native SCD2 -> dl_* Column Mapping
# ---------------------------------------------------------------------
# DLT's apply_changes with stored_as_scd_type=2 automatically creates two
# tracking columns on the physical target table:
#
#   __START_AT  -- the sequence/timestamp value when this version of the
#                  record became the current state.
#   __END_AT    -- the sequence/timestamp value when this version was
#                  superseded; NULL means the version is still current.
#
# The view overlay reads the physical table and maps these to the
# enterprise-standard columns requested:
#
#   dl_starttimeutc = CAST(__START_AT AS TIMESTAMP)
#       When this version of the record became effective.
#
#   dl_endtimeutc = CAST(__END_AT AS TIMESTAMP)
#       When this version was superseded (NULL = still current).
#
#   dl_iscurrent = (__END_AT IS NULL)
#       TRUE for the latest version of each key.
#
#   dl_isdeleted = (operation_column = 'DELETE')  [SCD2 only]
#       In SCD2, except_apply retains delete events as tombstone rows.
#       The tombstone's operation_column carries 'DELETE', which we
#       surface as dl_isdeleted.  For SCD1, hard deletes remove rows
#       entirely, so dl_isdeleted is always FALSE for visible records.
#
# Why stored_as_scd_type=2 for SCD1?
#   SCD1 semantically needs only the latest state (no history), which is
#   achieved with track_history=False.  However, using stored_as_scd_type=2
#   ensures the __START_AT / __END_AT columns exist on the physical table,
#   giving the view overlay a uniform mapping formula for both SCD types.
#   The trade-off is two extra nullable columns; the benefit is a single,
#   consistent code path for the view layer.
#
